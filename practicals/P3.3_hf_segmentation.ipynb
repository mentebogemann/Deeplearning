        "## 13. Visualize segmentation predictions\n",
        "\n",
        "Metrics are useful, but segmentation should also be inspected visually!"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 19,
      "id": "ZOTTS1tGO0vn",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 1000
        },
        "id": "ZOTTS1tGO0vn",
        "outputId": "75453419-c0ac-46c9-d836-caf4ac8d01d4"
      },
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1200x2000 with 15 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ],
      "source": [
        "def visualize_predictions(model, raw_dataset, processed_dataset, num_samples=5):\n",
        "    \"\"\"\n",
        "    Visualize multiple images, their ground-truth masks, and the model predictions.\n",
        "    \"\"\"\n",
        "    model.eval()\n",
        "\n",
        "    # Get the device where the model lives\n",
        "    device = next(model.parameters()).device\n",
        "\n",
        "    # Cap the number of samples if the dataset is smaller than requested\n",
        "    num_samples = min(num_samples, len(raw_dataset))\n",
        "\n",
        "    # Create a grid: num_samples rows, 3 columns.\n",
        "    # The height dynamically scales (4 inches per row) so it doesn't get squished.\n",
        "    fig, axes = plt.subplots(num_samples, 3, figsize=(12, 4 * num_samples))\n",
        "\n",
        "    for i in range(num_samples):\n",
        "        raw_example = raw_dataset[i]\n",
        "        processed_example = processed_dataset[i]\n",
        "\n",
        "        image = raw_example[\"images\"]\n",
        "        label = processed_example[\"labels\"]\n",
        "\n",
        "        pixel_values = processed_example[\"pixel_values\"].unsqueeze(0).to(device)\n",
        "\n",
        "        with torch.no_grad():\n",
        "            outputs = model(pixel_values=pixel_values)\n",
        "\n",
        "        logits = outputs.logits\n",
        "\n",
        "        if logits.shape[-2:] != label.shape[-2:]:\n",
        "            logits = F.interpolate(\n",
        "                logits,\n",
        "                size=label.shape[-2:],\n",
        "                mode=\"nearest\",\n",
        "            )\n",
        "\n",
        "        pred = logits.argmax(dim=1).squeeze(0).cpu()\n",
        "        label = label.cpu()\n",
        "\n",
        "        # Handle the axes array depending on if we have 1 row or multiple rows\n",
        "        ax_row = axes[i] if num_samples > 1 else axes\n",
        "\n",
        "        # Plot Image\n",
        "        ax_row[0].imshow(image)\n",
        "        if i == 0: ax_row[0].set_title(\"Input image\")\n",
        "        ax_row[0].axis(\"off\")\n",
        "\n",
        "        # Plot Ground Truth\n",
        "        ax_row[1].imshow(label, cmap=\"gray\", vmin=0, vmax=1)\n",
        "        if i == 0: ax_row[1].set_title(\"Ground truth\")\n",
        "        ax_row[1].axis(\"off\")\n",
        "\n",
        "        # Plot Prediction\n",
        "        ax_row[2].imshow(pred, cmap=\"gray\", vmin=0, vmax=1)\n",
        "        if i == 0: ax_row[2].set_title(\"Prediction\")\n",
        "        ax_row[2].axis(\"off\")\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# Call the function to see 5 images\n",
        "visualize_predictions(\n",
        "    model=model,\n",
        "    raw_dataset=val_raw,\n",
        "    processed_dataset=val_dataset,\n",
        "    num_samples=5,\n",
        ")"
      ]
    }
